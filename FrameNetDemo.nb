  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "FrameNetTangentField[image, opts] renders the projected tangent-field \
streamline overlay for image and returns it as an Image.", "Documentation" -> 
    None, "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, FrameNet`FrameNetTangentField, {FrameNet`FrameNetTangentField[
         Pattern[FrameNet`Private`session, 
          Blank[ExternalSessionObject]], 
         Pattern[FrameNet`Private`image, 
          Blank[Image]], 
         Pattern[FrameNet`Private`opts, 
          OptionsPattern[]]] :> 
       FrameNet`Private`withTemporaryImageFile[FrameNet`Private`image, 
         Function[{FrameNet`Private`file, FrameNet`Private`dir}, 
          
          Module[{FrameNet`Private`outFile, FrameNet`Private`result}, 
           FrameNet`Private`outFile = 
            FileNameJoin[{FrameNet`Private`dir, "tangent_field.png"}]; 
           FrameNet`Private`result = 
            ExternalEvaluate[
             FrameNet`Private`session, <|
              "Command" -> "framenet_render_tangent_field", 
               "Arguments" -> {FrameNet`Private`file, 
                 FrameNet`Private`resolveCheckpoint[
                  OptionValue["Checkpoint"]], FrameNet`Private`outFile, 
                 FrameNet`Private`resolveIntrinsics[
                  OptionValue["Intrinsics"]], 
                 FrameNet`Private`resolveDevice[
                  OptionValue["Device"]]}|>]; If[
             And[
              StringQ[FrameNet`Private`result], 
              FileExistsQ[FrameNet`Private`result]], 
             Import[FrameNet`Private`result], $Failed]]]], 
       FrameNet`FrameNetTangentField[
         Pattern[FrameNet`Private`image, 
          Blank[Image]], 
         Pattern[FrameNet`Private`opts, 
          OptionsPattern[]]] :> FrameNet`FrameNetTangentField[
         FrameNet`Private`ensureSession[], FrameNet`Private`image, 
         FrameNet`Private`opts]}], "SubValues" -> None, "DefaultValues" -> 
    None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     "Checkpoint" -> Automatic, "Intrinsics" -> Automatic, "Device" -> 
      Automatic}, "Attributes" -> {}, "FullName" -> 
    "FrameNet`FrameNetTangentField"|>, False]]], "Output",
