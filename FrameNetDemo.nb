Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = False, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox[
             TagBox[
              TooltipBox[
               StyleBox["\<\" Symbol\"\>", "InformationRowLabel",
                StripOnInput->False],
               "\"Symbol\"",
               TooltipStyle->"TextStyling"],
              Annotation[#, "Symbol", "Tooltip"]& ], "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"FrameNetTangentField[image, opts] renders the \
projected tangent-field streamline overlay for image and returns it as an \
Image.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[
           TagBox[GridBox[{
              {
               StyleBox[
                TagBox[
                 TooltipBox[
                  StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                   StripOnInput->False],
                  "\"Definitions\"",
                  TooltipStyle->"TextStyling"],
                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"FrameNetTangentField", "[", 
                    
                    RowBox[{
                    "FrameNet`Private`session_ExternalSessionObject", ",", 
                    "FrameNet`Private`image_Image", ",", 
                    RowBox[{"FrameNet`Private`opts", ":", 
                    RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
                    RowBox[{"FrameNet`Private`withTemporaryImageFile", "[", 
                    RowBox[{"FrameNet`Private`image", ",", 
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"FrameNet`Private`file", ",", 
                    "FrameNet`Private`dir"}], "}"}], ",", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"FrameNet`Private`outFile", ",", 
                    "FrameNet`Private`result"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"FrameNet`Private`outFile", "=", 
                    RowBox[{"FileNameJoin", "[", 
                    RowBox[{"{", 
                    
                    RowBox[{"FrameNet`Private`dir", ",", 
                    "\"tangent_field.png\""}], "}"}], "]"}]}], ";", 
                    RowBox[{"FrameNet`Private`result", "=", 
                    RowBox[{"ExternalEvaluate", "[", 
                    RowBox[{"FrameNet`Private`session", ",", 
                    RowBox[{"Association", "[", 
                    RowBox[{
                    
                    RowBox[{"\"Command\"", "\[Rule]", 
                    "\"framenet_render_tangent_field\""}], ",", 
                    RowBox[{"\"Arguments\"", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{"FrameNet`Private`file", ",", 
                    RowBox[{"FrameNet`Private`resolveCheckpoint", "[", 
                    RowBox[{"OptionValue", "[", "\"Checkpoint\"", "]"}], 
                    "]"}], ",", "FrameNet`Private`outFile", ",", 
                    RowBox[{"FrameNet`Private`resolveIntrinsics", "[", 
                    RowBox[{"OptionValue", "[", "\"Intrinsics\"", "]"}], 
                    "]"}], ",", 
                    RowBox[{"FrameNet`Private`resolveDevice", "[", 
                    RowBox[{"OptionValue", "[", "\"Device\"", "]"}], "]"}]}], 
                    "}"}]}]}], "]"}]}], "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"StringQ", "[", "FrameNet`Private`result", "]"}], 
                    "&&", 
                    
                    RowBox[{"FileExistsQ", "[", "FrameNet`Private`result", 
                    "]"}]}], ",", 
                    RowBox[{"Import", "[", "FrameNet`Private`result", "]"}], 
                    ",", "$Failed"}], "]"}]}]}], "]"}]}], "]"}]}], "]"}]}]}, {
                   " "}, {
                    RowBox[{
                    RowBox[{"FrameNetTangentField", "[", 
                    RowBox[{"FrameNet`Private`image_Image", ",", 
                    RowBox[{"FrameNet`Private`opts", ":", 
                    RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
                    RowBox[{"FrameNetTangentField", "[", 
                    RowBox[{
                    RowBox[{"FrameNet`Private`ensureSession", "[", "]"}], ",",
                     "FrameNet`Private`image", ",", "FrameNet`Private`opts"}],
                     "]"}]}]}, {" "}}, 
                  GridBoxAlignment -> {"Columns" -> {{Left}}}, 
                  DefaultBaseStyle -> "Column", 
                  GridBoxItemSize -> {
                   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]},
                "RowDefault"]}
             },
             DefaultBaseStyle->"Column",
             GridBoxAlignment->{"Columns" -> {{Left}}},
             
             GridBoxItemSize->{
              "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
            "Column"],
           FrameMargins->{{6, 0}, {3, 6}}], "\<\"\"\>"},
         {
          PaneBox[GridBox[{
             {
              
              DynamicModuleBox[{System`InformationDump`open$$ = {
               False, False, False, False, False, False}}, 
               StyleBox[GridBox[{
                  {
